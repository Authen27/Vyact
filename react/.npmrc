# Supply-chain hardening (v10.137.0, owner decision 26 Oct 2026): no package runs an install script on a
# developer machine, in CI or on Vercel. The 2026 npm worms (keyv / Shai-Hulud and others) spread through them.
# npm then also skips our own pre/post hooks, so none may exist: the build runs every step itself
# (scripts/build.mjs), and scripts/__tests__/supply-chain.test.mjs refuses a new hook.
ignore-scripts=true
